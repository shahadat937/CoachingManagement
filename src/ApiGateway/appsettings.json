{
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**rest}"
        }
      },
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/{**rest}"
        }
      },
      "academic": {
        "ClusterId": "academic",
        "Match": {
          "Path": "/api/subjects/{**rest}"
        }
      },
      "academic-setup": {
        "ClusterId": "academic",
        "Match": {
          "Path": "/api/academic/{**rest}"
        }
      },
      "students": {
        "ClusterId": "students",
        "Match": {
          "Path": "/api/students/{**rest}"
        }
      },
      "attendance": {
        "ClusterId": "attendance",
        "Match": {
          "Path": "/api/attendance/{**rest}"
        }
      },
      "devices": {
        "ClusterId": "devices",
        "Match": {
          "Path": "/api/devices/{**rest}"
        }
      },
      "accounts": {
        "ClusterId": "accounts",
        "Match": {
          "Path": "/api/fee-invoices/{**rest}"
        }
      },
      "exams": {
        "ClusterId": "exams",
        "Match": {
          "Path": "/api/exams/{**rest}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://identity-api:8080"
          }
        }
      },
      "academic": {
        "Destinations": {
          "d1": {
            "Address": "http://academic-api:8080"
          }
        }
      },
      "students": {
        "Destinations": {
          "d1": {
            "Address": "http://students-api:8080"
          }
        }
      },
      "attendance": {
        "Destinations": {
          "d1": {
            "Address": "http://attendance-api:8080"
          }
        }
      },
      "devices": {
        "Destinations": {
          "d1": {
            "Address": "http://devices-api:8080"
          }
        }
      },
      "accounts": {
        "Destinations": {
          "d1": {
            "Address": "http://accounts-api:8080"
          }
        }
      },
      "exams": {
        "Destinations": {
          "d1": {
            "Address": "http://exams-api:8080"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*"
}
