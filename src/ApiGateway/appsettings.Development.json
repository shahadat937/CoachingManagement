{
  "ReverseProxy": {
    "Routes": {
      "identity-auth": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/auth/{**rest}"
        }
      },
      "identity": {
        "ClusterId": "identity",
        "Match": {
          "Path": "/api/users/{**rest}"
        }
      },
      "academic": {
        "ClusterId": "academic",
        "Match": {
          "Path": "/api/subjects/{**rest}"
        }
      },
      "academic-setup": {
        "ClusterId": "academic",
        "Match": {
          "Path": "/api/academic/{**rest}"
        }
      },
      "students": {
        "ClusterId": "students",
        "Match": {
          "Path": "/api/students/{**rest}"
        }
      },
      "attendance": {
        "ClusterId": "attendance",
        "Match": {
          "Path": "/api/attendance/{**rest}"
        }
      },
      "devices": {
        "ClusterId": "devices",
        "Match": {
          "Path": "/api/devices/{**rest}"
        }
      },
      "accounts": {
        "ClusterId": "accounts",
        "Match": {
          "Path": "/api/fee-invoices/{**rest}"
        }
      },
      "exams": {
        "ClusterId": "exams",
        "Match": {
          "Path": "/api/exams/{**rest}"
        }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5001"
          }
        }
      },
      "academic": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5002"
          }
        }
      },
      "students": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5003"
          }
        }
      },
      "attendance": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5004"
          }
        }
      },
      "devices": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5005"
          }
        }
      },
      "accounts": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5006"
          }
        }
      },
      "exams": {
        "Destinations": {
          "d1": {
            "Address": "http://localhost:5007"
          }
        }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*"
}
