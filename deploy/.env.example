# Copy this file to deploy/.env and fill the blank secret values before running Docker Compose.
# Generate the signing secret with: openssl rand -base64 48
JWT_SIGNING_KEY=
JWT_ISSUER=CoachingManagement
JWT_AUDIENCE=CoachingManagement.Web
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60

# Used only at first startup, or to recover an installation with no Admin role.
# Do not keep this password in source control.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
